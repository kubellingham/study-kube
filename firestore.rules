rules_version = '2';

// Studying Kube — what the BROWSER may touch.
//
// Everything the server does runs through the Admin SDK, which bypasses these
// rules entirely, so locking a collection down here never breaks a server flow.
//
// The model is DENY BY DEFAULT: one named list of the collections the app
// legitimately reads and writes from the browser, each scoped to its owner by
// the `userId` field every one of those documents carries. A collection that
// isn't named is unreachable from the browser.
//
// This replaces a catch-all `match /{collection}/{docId}` that let a signed-in
// user CREATE a document in ANY top-level collection as long as they stamped
// their own uid on it — including the collections that decide who has paid. A
// user with no entitlement document could write their own
// `entitlements/<uid>` with `promoTier: "summit"` from the browser console,
// and the server, which trusts that document, would hand them the top tier for
// free. Forging a promo code, a crew or a referral worked the same way. The
// browser never touches any of those collections in this app, so none of them
// is on the list.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    // The collections the browser owns: a student's own learning record and
    // the shelf of material Kube is holding. Anything not here is server-only.
    function browserOwned() {
      return [
        'learnProgress', 'practiceState', 'studyPlan', 'mistakes',
        'questionFlags', 'slideFeedback', 'learningEvents', 'examAttempts',
        'chatNotes', 'shelfItems'
      ];
    }

    // Returns the caller's crew leader uid, or null if they aren't in a crew.
    // The entitlements doc is written by the Stripe webhook / joinCrew flow.
    function myCrewLeaderUid() {
      return signedIn()
        ? get(/databases/$(database)/documents/entitlements/$(request.auth.uid))
            .data.crewLeaderUid
        : null;
    }
    function inCrewFor(data) {
      return signedIn()
        && data.keys().hasAny(['crewId'])
        && data.crewId != null
        && data.crewId == myCrewLeaderUid();
    }

    // ── Subjects ─────────────────────────────────────────────────────────
    match /courses/{docId} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      // Crew members get read-only access to courses shared with their crew.
      allow read: if inCrewFor(resource.data);
    }

    // ── Digest jobs — written by the server, watched by the browser ──────
    // The app follows a digest's progress live. It has no business writing
    // one: a forged job would let someone fake a finished build.
    match /ingestJobs/{docId} {
      allow read: if owns(resource.data);
    }

    // ── Everything else the browser owns ─────────────────────────────────
    match /{col}/{docId} {
      allow read, delete: if col in browserOwned() && owns(resource.data);
      allow create: if col in browserOwned() && owns(request.resource.data);
      allow update: if col in browserOwned()
        && owns(resource.data)
        && owns(request.resource.data);
    }
  }
}
