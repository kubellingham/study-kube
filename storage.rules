rules_version = '2';

// PDF originals live at materials/<uid>/<materialId>.pdf and are private to
// the owner.
service firebase.storage {
  match /b/{bucket}/o {
    match /materials/{uid}/{file=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The shelf: material Kube is holding but hasn't built yet, at
    // shelf/<uid>/<courseId>/<itemId>.json. Private to the owner, same as
    // everything else they upload.
    match /shelf/{uid}/{file=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
