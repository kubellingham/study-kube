# ---- Studying Kube environment ----
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.

# Your Claude API key (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/  -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Supabase ----
# Create a free project at https://supabase.com/ then find these under
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
