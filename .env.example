# ---- Studying Kube environment ----
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.

# Your Claude API key (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/  -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Firebase (client config) ----
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
# These are public values, safe to ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# OPTIONAL — Cloud Storage keeps a copy of uploaded PDF originals. It requires
# the Firebase Blaze plan. Leave this BLANK to stay on the free Spark plan;
# the app works fully without it (PDF text is extracted and stored in Firestore).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# ---- Stripe (server only — SECRET) ----
# Two values, and only two: the browser never talks to Stripe, because checkout
# runs on Stripe's own hosted page. There is no publishable key here.
#
# STRIPE_SECRET_KEY — Stripe Dashboard -> Developers -> API keys -> secret key.
#   sk_test_... while you're testing, sk_live_... once the account is activated.
#   This key can move money and read customer data: Vercel env only, never the
#   repo, never a NEXT_PUBLIC_ name.
# STRIPE_WEBHOOK_SECRET — Developers -> Webhooks -> your endpoint
#   (https://<domain>/api/stripe/webhook) -> "Signing secret". Each endpoint has
#   its OWN secret, and the test and live endpoints are different ones. Without
#   the matching secret every webhook is rejected, and nobody's payment lands.
#
# With the keys set, an owner runs the one-time provisioning from /admin: it
# creates the products, prices and intro coupons in whichever mode the key is
# for, and is safe to re-run.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Firebase Admin (server only — SECRET) ----
# Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key". Copy these three fields from the downloaded JSON.
# For FIREBASE_PRIVATE_KEY, keep it on one line with literal \n escapes, wrapped
# in double quotes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
